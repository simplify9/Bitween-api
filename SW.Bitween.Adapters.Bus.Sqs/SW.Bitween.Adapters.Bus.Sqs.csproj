<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>SW.Bitween.Adapters.Bus.Sqs</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.87" />
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The settings contract is source, not a package: Bitween reads these attributes by name
         through a MetadataLoadContext, so no assembly identity has to line up. -->
    <Compile Include="..\SW.Bitween.Adapters.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
