<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SW.Bitween.Adapters.Db.SqlServer</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.0" />
    <!--
      Microsoft.Data.SqlClient, not the System.Data.SqlClient that ships in the framework: the
      latter is frozen, and the difference that matters here is that it never learned to trust a
      modern certificate chain, which is what a managed Azure SQL instance presents.

      Pinned to the 5.x line: 6.x requires net8.0 at minimum for some assets and moves the default
      of Encrypt again, and this adapter is deployed to a fleet where a silent change to how a
      connection is secured is not something to inherit from a package bump.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SW.Bitween.Adapters.Db.Core/SW.Bitween.Adapters.Db.Core.csproj" />
  </ItemGroup>

</Project>
