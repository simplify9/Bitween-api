<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SW.Bitween.UnitTests" />
        <!-- The pipeline hands the built-in adapters its parsed payload (ParsedXchangeFile), which nothing outside needs. -->
        <InternalsVisibleTo Include="SW.Bitween.Api" />
        <InternalsVisibleTo Include="SW.Bitween.IntegrationTests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
      <PackageReference Include="CsvHelper" Version="33.1.0" />
      <!-- Aliased, and kept out of dependents' compiles: its root namespace, DocumentFormat, is the name of Bitween's own type. -->
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" Aliases="OpenXml" PrivateAssets="compile" />
      <PackageReference Include="DocumentFormat.OpenXml.Framework" Version="3.5.1" Aliases="OpenXml" PrivateAssets="compile" />
      <PackageReference Include="DotLiquid" Version="2.2.692" />
      <PackageReference Include="MailKit" Version="4.17.0" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
      <PackageReference Include="Rebex.Ftp" Version="8.0.9673" />
      <PackageReference Include="Rebex.Mail" Version="8.0.9673" />
      <PackageReference Include="Rebex.Pop3" Version="8.0.9673" />
      <PackageReference Include="Rebex.Sftp" Version="8.0.9673" />
      <PackageReference Include="Scriban" Version="7.4.0" />
      <PackageReference Include="SSH.NET" Version="2026.0.0" />
      <PackageReference Include="FluentFTP" Version="55.0.0" />
      <PackageReference Include="SimplyWorks.CloudFiles.S3" Version="10.0.2" />
      <PackageReference Include="SimplyWorks.PrimitiveTypes" Version="10.0.1" />
    </ItemGroup>

  <ItemGroup>
    <!-- Each adapter's manifest - what a catalog or marketplace shows for it - beside its code. -->
    <EmbeddedResource Include="*/adapter.json" />
  </ItemGroup>

</Project>
