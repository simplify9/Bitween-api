<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>SW.Bitween.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="MockRequestContext.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.1" />
    <PackageReference Include="SimplyWorks.CqApi" Version="8.2.6" />
    <PackageReference Include="SimplyWorks.Bus" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SW.Bitween.Api\SW.Bitween.Api.csproj" />
    <!-- All three providers, so MigrationDriftTests can check every one of them. A provider
         left out here is a provider whose migration drift nobody notices until it crashes on
         startup in whichever environment happens to use it. -->
    <ProjectReference Include="..\SW.Bitween.PgSql\SW.Bitween.PgSql.csproj" />
    <ProjectReference Include="..\SW.Bitween.MsSql\SW.Bitween.MsSql.csproj" />
    <ProjectReference Include="..\SW.Bitween.MySql\SW.Bitween.MySql.csproj" />

    <!-- The engine-independent half of the database adapters. Targets net8.0 like every adapter;
         referencing it from a net10.0 test project is fine and keeps the pure logic — the
         statement allow-list, cursor formatting — testable without a database. -->
    <ProjectReference Include="..\SW.Bitween.Adapters.Db.Core\SW.Bitween.Adapters.Db.Core.csproj" />
    <!-- For the capability-narrowing rule, which is a version comparison rather than anything the
         database does — so it is provable without a container per PostgreSQL release. -->
    <ProjectReference Include="..\SW.Bitween.Adapters.Db.PostgreSql\SW.Bitween.Adapters.Db.PostgreSql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="sampledoc2.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="sampledoc.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
