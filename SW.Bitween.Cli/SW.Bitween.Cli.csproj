<Project Sdk="Microsoft.NET.Sdk">

  <!-- The bitween command: Bitween from a terminal. Adapters first - written, built, checked and
       published with Bitween's contract - and signing in to a Bitween, which the rest builds on. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bitween</AssemblyName>
    <RootNamespace>SW.Bitween.Cli</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <!-- Ed25519, for signing what bitween registry publish sends. Aliased, as in the API: another
         dependency brings the older BouncyCastle.Crypto, with the same type names. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" Aliases="BouncyCastle2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SW.Bitween.Adapters.Tooling\SW.Bitween.Adapters.Tooling.csproj" />
    <ProjectReference Include="..\SW.Bitween.Configuration\SW.Bitween.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SW.Bitween.HttpTests" />
  </ItemGroup>

</Project>
