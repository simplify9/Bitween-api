<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SW.Bitween.Adapters.Db.Oracle</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="8.1.23" />
    <!--
      The managed driver, deliberately: the unmanaged one needs Oracle Instant Client installed on
      every node, which a self-contained adapter published to cloud storage cannot assume.
    -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.9.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SW.Bitween.Adapters.Db.Core/SW.Bitween.Adapters.Db.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SW.Bitween.UnitTests" />
  </ItemGroup>
</Project>
