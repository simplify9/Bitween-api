<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SW.Bitween.Adapters.Db.MySql</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.0" />
    <!--
      MySqlConnector, not Oracle's MySql.Data: it is the fully async ADO.NET implementation, and
      the async in this adapter is not decorative — a resident adapter serves every subscription
      bound to the connection, so a driver that blocks a thread per call caps the whole data source.
    -->
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SW.Bitween.Adapters.Db.Core/SW.Bitween.Adapters.Db.Core.csproj" />
  </ItemGroup>

</Project>
