<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SW.Bitween</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aliased: another dependency brings the older BouncyCastle.Crypto, with the same type names. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" Aliases="BouncyCastle2" />
    <PackageReference Include="NJsonSchema" Version="11.6.1" />
    <PackageReference Include="SimplyWorks.Serverless" Version="10.2.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Services\AccessKeySetService.cs" />
    <Compile Remove="Services\AdapterService.cs" />
    <Compile Remove="Services\DocumemtService.cs" />
    <Compile Remove="Services\BitweenRepo.cs" />
    <Compile Remove="Services\ReceiverService.cs" />
    <Compile Remove="Services\SubscriberService.cs" />
  </ItemGroup>
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>
  <ItemGroup>
    <!-- The AI providers AI features call: Settings, AI picks one. -->
    <PackageReference Include="Anthropic" Version="12.54.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols" Version="8.3.1" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.3.1" />
    <!-- Compile-time only, for validating a cron expression before it's stored. Quartz already
         ships with the app through SimplyWorks.Scheduler.EfCore. -->
    <PackageReference Include="Quartz" Version="3.15.0" />
    <!-- The queue-name prefix, vhost and management credentials all live on BusOptions, which is
         in the implementation package rather than the contracts one. Ops/UnattendedQueues needs
         them to ask the broker what exists; without this it would have to rebuild each of them
         from configuration and get them subtly wrong. Already in the app through SW.Bitween.Web -
         keep the version in step with it. -->
    <PackageReference Include="SimplyWorks.Bus" Version="10.1.0" />
    <PackageReference Include="SimplyWorks.Bus.RabbitMqExtensions" Version="10.1.0" />
    <!-- 8.1.9 is the first version carrying AuditOptions, which AuditPolicy needs. -->
    <PackageReference Include="SimplyWorks.EfCoreExtensions" Version="10.0.0" />
    <PackageReference Include="SimplyWorks.Scheduler.Sdk" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- SW-Serverless's tooling with Bitween's contract, kinds and packages, for the adapter editor:
         what Bitween builds and publishes is exactly what the bitween CLI would. -->
    <ProjectReference Include="..\SW.Bitween.Adapters.Tooling\SW.Bitween.Adapters.Tooling.csproj" />
    <ProjectReference Include="..\SW.Bitween.Configuration\SW.Bitween.Configuration.csproj" />
    <ProjectReference Include="..\SW.Bitween.NativeAdapters\SW.Bitween.NativeAdapters.csproj" />
    <ProjectReference Include="..\SW.Bitween.Sdk\SW.Bitween.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads adapter assemblies without loading them; see BusProviderCatalog. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- For AccountExtensions.MicrosoftSigningKeys: sign-in with Microsoft tested end to end. -->
    <InternalsVisibleTo Include="SW.Bitween.IntegrationTests" />
    <InternalsVisibleTo Include="SW.Bitween.UnitTests" />
    <InternalsVisibleTo Include="SW.Bitween.HttpTests" />
  </ItemGroup>

</Project>
