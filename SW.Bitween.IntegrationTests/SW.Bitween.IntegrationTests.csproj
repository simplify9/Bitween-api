<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SW.Bitween.IntegrationTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Update="NodeAdapters/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="PythonAdapters/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="SimplyWorks.CloudFiles.LocalTests.Extensions" Version="10.0.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Testcontainers — Docker-based infrastructure -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="3.10.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="3.10.0" />
    <PackageReference Include="Testcontainers.Oracle" Version="3.10.0" />
    <PackageReference Include="Testcontainers.MySql" Version="3.10.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="3.10.0" />
    <!-- The test seeds its schema directly, before the adapter is anywhere near it. -->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.9.1" />
    <!-- Seeding only: the adapters carry their own copies, and these are how a test sets a schema
         up and reads results back without going through the adapter it is testing. -->
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- So an Oracle that is not available here SKIPS rather than fails: the image is nearly five
         gigabytes, and a developer without it should still get every other result in this suite. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- Talks the SQS API without LocalStack's weight; the fixture already starts a plain
         container for MailHog, so this follows the same pattern. -->
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.87" />
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />

    <!-- Serverless runtime -->
    <PackageReference Include="SimplyWorks.Serverless" Version="10.2.0" />
    <!-- serverless build and publish as a library: the Python adapters here are built and published
         the way the CLI does it. -->
    <PackageReference Include="SimplyWorks.Serverless.Tooling" Version="10.2.0" />

    <!-- Bus (for IPublish + AddBus registration) -->
    <PackageReference Include="SimplyWorks.Bus" Version="10.0.1" />

    <!-- EF Core naming conventions (used by PgSql context) -->
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SW.Bitween.Api\SW.Bitween.Api.csproj" />
    <ProjectReference Include="..\SW.Bitween.PgSql\SW.Bitween.PgSql.csproj" />
  </ItemGroup>

  <Target Name="PublishTestAdapters" AfterTargets="Build">
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.SampleHandler -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.SampleHandler --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.SampleValidator -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.SampleValidator --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.SampleConfigurableAdapter -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.SampleConfigurableAdapter --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Bus.RabbitMq -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Bus.RabbitMq --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Bus.Sqs -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Bus.Sqs --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Db.PostgreSql -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Db.PostgreSql --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Db.Oracle -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Db.Oracle --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Db.MySql -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Db.MySql --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.Adapters.Db.SqlServer -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.Adapters.Db.SqlServer --no-self-contained" />
    <Exec Command="dotnet publish $(MSBuildThisFileDirectory)../SW.Bitween.SampleResidentHandler -c $(Configuration) -o $(OutputPath)test-adapters/SW.Bitween.SampleResidentHandler --no-self-contained" />
  </Target>

</Project>
