<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SW.Bitween.Adapters.Db.PostgreSql</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.1" />
    <!-- Still on the 8.x line. The old adapter target that forced this is gone; moving to Npgsql 9+
         is a driver upgrade of its own, to be tested against the PostgreSQL versions in the field. -->
    <PackageReference Include="Npgsql" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SW.Bitween.Adapters.Db.Core/SW.Bitween.Adapters.Db.Core.csproj" />
  </ItemGroup>

</Project>
