<Project Sdk="Microsoft.NET.Sdk">

  <!-- Bitween from another program, signed in as a service account: search, read, retry and export
       exchanges, and set integrations up - partners, subscriptions, gateways, notification channels.
       BitweenGateway sends to an API gateway as a partner. Published to NuGet as SimplyWorks.Bitween.Client; the rows and
       plans it answers with are the API's own, from SimplyWorks.Bitween.Sdk, so the two can't drift. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>SimplyWorks.Bitween.Client</PackageId>
    <Product>SimplyWorks.Bitween.Client</Product>
    <Description>Bitween from your own program: search, retry and export exchanges; set up partners, subscriptions, gateways and notification channels as a service account; and send to gateways as a partner.</Description>
    <Authors>Simplify9</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/simplify9/Bitween</PackageProjectUrl>
    <RepositoryUrl>https://github.com/simplify9/Bitween</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RootNamespace>SW.Bitween.Client</RootNamespace>
    <!-- The summaries go in the package, so they show where the client is used. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SW.Bitween.Sdk\SW.Bitween.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
